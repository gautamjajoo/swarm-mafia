      "actor_id": "reviewer",
      "task_id": "report",
      "recipient_ids": [
        "researcher"
      ]
    },
    {
      "id": "report-revised",
      "occurred_at": "2026-10-05T12:10:00Z",
      "kind": "artifact.updated",
      "data": {
        "artifact_id": "team-report",
