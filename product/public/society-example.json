      "actor_id": "researcher",
      "task_id": "report"
    },
    {
      "id": "recheck-call",
      "occurred_at": "2026-10-05T12:11:00Z",
      "kind": "tool.called",
      "data": {
        "call_id": "check-2",
        "tool_name": "fetch_report",
        "arguments": {
          "artifact_id": "team-report"
        }
      },
      "actor_id": "reviewer",
      "task_id": "report"
    },
    {
      "id": "recheck-ok",
      "occurred_at": "2026-10-05T12:12:00Z",
      "kind": "tool.returned",
      "data": {
        "call_id": "check-2",
        "success": true,
        "output": {
          "status": 200,
          "revision_id": "draft-2"
        }
