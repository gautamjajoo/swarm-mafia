      "actor_id": "reviewer",
      "task_id": "report",
      "recipient_ids": [
        "researcher"
      ]
    },
    {
      "id": "background-call",
      "occurred_at": "2026-10-05T12:14:00Z",
      "kind": "tool.called",
      "data": {
        "call_id": "uncaptured-result",
        "tool_name": "archive_report"
      },
      "actor_id": "researcher",
      "task_id": "report"
    }
