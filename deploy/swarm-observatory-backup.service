[Unit]
Description=Back up Swarm Observatory SQLite to private GCS
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/swarm-observatory

[Service]
Type=oneshot
User=jajoo_kairosity_ai
Group=jajoo_kairosity_ai
EnvironmentFile=/etc/swarm-observatory/backend.env
ExecStart=/home/jajoo_kairosity_ai/swarm-observatory/venv/bin/python /home/jajoo_kairosity_ai/swarm-deploy/backup-sqlite.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/swarm-observatory/backups /srv/swarm-observatory/data
TimeoutStartSec=7200
